---
import Base from '../../layouts/Base.astro';
import { getPosts, getTags, formatDate } from '../../lib/cms';

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTags()]);
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: {
      tag,
      posts: posts.filter((p) => p.tags.some((t) => t.slug === tag.slug)),
    },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag.name}`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 w-full space-y-8">
    <div>
      <a href="/" class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 transition-colors">
        ← Volver al inicio
      </a>
    </div>

    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/90 shadow-sm">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
        Etiqueta
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mt-3">
        #{tag.name}
      </h1>
      <p class="text-slate-500 text-sm mt-2">
        {posts.length} {posts.length === 1 ? 'artículo' : 'artículos'} con esta etiqueta.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="bg-white rounded-2xl border border-slate-200/90 p-8 text-center text-slate-500 text-sm">
        No hay artículos con esta etiqueta por el momento.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((p) => (
          <article class="group relative rounded-2xl bg-white border border-slate-200/90 overflow-hidden flex flex-col justify-between hover:border-blue-400/60 hover:shadow-lg transition-all duration-300">
            {p.featured_image ? (
              <div class="h-40 w-full overflow-hidden bg-slate-100">
                <img 
                  src={p.featured_image.url} 
                  alt={p.featured_image.alt_text || p.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
            ) : (
              <div class="h-40 w-full bg-[#0A1128] p-5 flex items-center justify-center text-white">
                <span class="font-mono text-sm font-bold tracking-wider">{p.title}</span>
              </div>
            )}
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
                  <a href={p.path}>
                    <span class="absolute inset-0"></span>
                    {p.title}
                  </a>
                </h3>
                {p.excerpt && (
                  <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mt-2.5">
                    {p.excerpt}
                  </p>
                )}
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                <span>{p.reading_minutes} min</span>
                <time>{formatDate(p.published_at)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</Base>
