---
import Base from '../layouts/Base.astro';
import { getPosts, getCategories, getTags, formatDate } from '../lib/cms';

const posts = await getPosts();
const categories = await getCategories();
const tags = await getTags();

const recentPosts = posts.slice(0, 3);

// Formateador de fecha idéntico al Figma: "5 OCT 2026"
function formatFigmaDate(iso: string) {
  try {
    const d = new Date(iso);
    const day = d.getUTCDate();
    const month = d.toLocaleDateString('es-MX', { month: 'short', timeZone: 'UTC' }).replace('.', '').toUpperCase();
    const year = d.getUTCFullYear();
    return `${day} ${month} ${year}`;
  } catch {
    return formatDate(iso);
  }
}

// Banners de respaldo para posts sin imagen destacada (estilo EduControl, HomeScore, UPlace de Figma)
const fallbackCardStyles = [
  {
    bg: 'bg-[#0F172A]',
    textColor: 'text-white',
    subColor: 'text-slate-400',
    icon: 'educontrol',
  },
  {
    bg: 'bg-[#0284C7]',
    textColor: 'text-white',
    subColor: 'text-sky-100',
    icon: 'homescore',
  },
  {
    bg: 'bg-[#F1F5F9]',
    textColor: 'text-slate-800',
    subColor: 'text-slate-500',
    icon: 'uplace',
  },
];

// Helper visual para tematizar categorías según Figma (Kotlin, FastAPI, Python, React, etc.)
function getCategoryDesign(name: string) {
  const n = (name || '').toLowerCase();
  if (n.includes('kotlin') || n.includes('android')) {
    return {
      headerBg: 'bg-[#F5F3FF]',
      title: 'Desarrollo móvil',
      desc: 'Aplicaciones y experiencias Android.',
      badgeText: 'KOTLIN',
      badgeClass: 'bg-purple-100 text-purple-700',
      icon: 'kotlin',
    };
  }
  if (n.includes('fastapi') || n.includes('api') || n.includes('backend')) {
    return {
      headerBg: 'bg-[#ECFDF5]',
      title: 'Servicios web',
      desc: 'Una ruta para explorar APIs con Python.',
      badgeText: 'FASTAPI',
      badgeClass: 'bg-emerald-100 text-emerald-700',
      icon: 'fastapi',
    };
  }
  if (n.includes('python')) {
    return {
      headerBg: 'bg-[#FEFCE8]',
      title: 'Fundamentos',
      desc: 'Práctica, automatización y nuevos retos.',
      badgeText: 'PYTHON',
      badgeClass: 'bg-amber-100 text-amber-800',
      icon: 'python',
    };
  }
  if (n.includes('react') || n.includes('frontend') || n.includes('web')) {
    return {
      headerBg: 'bg-[#F0F9FF]',
      title: 'Interfaces web',
      desc: 'Construcción de experiencias para navegador.',
      badgeText: 'REACT',
      badgeClass: 'bg-sky-100 text-sky-700',
      icon: 'react',
    };
  }
  // Categoría por defecto del CMS (ej. "Sin categoría" u otra)
  return {
    headerBg: 'bg-slate-100',
    title: name,
    desc: 'Artículos y notas técnicas publicadas.',
    badgeText: name.toUpperCase(),
    badgeClass: 'bg-blue-100 text-blue-700',
    icon: 'code',
  };
}
---

<Base title="Inicio">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 w-full space-y-14">
    
    <!-- Hero Section idéntico al Figma -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-200/90 shadow-sm flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12 relative overflow-hidden">
      <!-- Columna izquierda: Información -->
      <div class="space-y-4 max-w-xl z-10">
        <span class="inline-flex items-center text-xs font-bold font-mono tracking-wider text-blue-600 bg-blue-50 px-3.5 py-1.5 rounded-full border border-blue-100 uppercase">
          Blog de aprendizaje
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-black tracking-tight text-slate-900 leading-[1.15]">
          Ideas, práctica y evolución.
        </h1>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Un espacio para documentar lo que voy aprendiendo en tecnología: cómo abordo un reto, qué decisiones tomo y qué me llevo de cada experiencia.
        </p>
        <div class="pt-3">
          <a 
            href="#articulos" 
            class="inline-flex items-center gap-2 bg-[#2563EB] hover:bg-blue-600 text-white text-xs sm:text-sm font-semibold px-6 py-3 rounded-xl transition-all shadow-md shadow-blue-500/25 active:scale-95"
          >
            Explorar artículos
          </a>
        </div>
      </div>

      <!-- Columna derecha: Snippet de código / Terminal visual de Figma (520x165) -->
      <div class="w-full lg:w-auto z-10 flex justify-center">
        <div class="w-full max-w-[520px] bg-[#0A1128] rounded-2xl p-5 border border-slate-800 shadow-xl relative overflow-hidden font-mono text-xs sm:text-sm select-none">
          <!-- Botones de la ventana estilo Figma -->
          <div class="flex items-center gap-2 mb-4">
            <span class="w-3 h-3 rounded-full bg-[#EF4444] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#F59E0B] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#10B981] inline-block"></span>
          </div>

          <!-- Código con resaltado exacto de sintaxis -->
          <div class="space-y-1.5 leading-relaxed">
            <div>
              <span class="text-[#F43F5E] font-semibold">const</span>
              <span class="text-sky-400"> aprendizaje</span>
              <span class="text-white"> = {</span>
            </div>
            <div class="pl-6">
              <span class="text-slate-300">curiosidad:</span>
              <span class="text-sky-300"> "siempre"</span><span class="text-white">,</span>
            </div>
            <div class="pl-6">
              <span class="text-slate-300">práctica:</span>
              <span class="text-emerald-400 font-semibold"> true</span><span class="text-white">,</span>
            </div>
            <div class="pl-6">
              <span class="text-slate-300">progreso:</span>
              <span class="text-sky-300"> "paso a paso"</span>
            </div>
            <div>
              <span class="text-white">};</span>
            </div>
          </div>

          <!-- Píldora inferior derecha -->
          <div class="mt-4 flex justify-end">
            <span class="bg-slate-800/90 text-slate-400 text-[10px] font-bold tracking-wider px-3 py-1 rounded-full uppercase border border-slate-700/60">
              Una idea a la vez
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 1: Lo más reciente (Lecturas recientes) -->
    <section id="articulos" class="space-y-6">
      <div class="flex items-end justify-between">
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500">Lecturas recientes</span>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Lo más reciente</h2>
        </div>
        <a href="#articulos" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition-colors flex items-center gap-1">
          Ver todos los artículos ›
        </a>
      </div>

      {recentPosts.length === 0 ? (
        <div class="bg-white rounded-2xl border border-slate-200/90 p-8 text-center text-slate-500 text-sm">
          Aún no hay artículos publicados en el CMS.
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map((p, idx) => {
            const fallbackStyle = fallbackCardStyles[idx % fallbackCardStyles.length];
            const primaryCat = p.categories && p.categories.length > 0 ? p.categories[0] : null;

            return (
              <article class="group relative rounded-2xl bg-white border border-slate-200/90 overflow-hidden flex flex-col justify-between hover:border-blue-400/60 hover:shadow-lg transition-all duration-300">
                <!-- Cabecera de la tarjeta: Imagen del post o Banner de maqueta Figma -->
                {p.featured_image ? (
                  <div class="h-40 w-full overflow-hidden bg-slate-100 relative">
                    <img 
                      src={p.featured_image.url} 
                      alt={p.featured_image.alt_text || p.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                ) : (
                  <div class={`h-40 w-full p-5 flex flex-col items-center justify-center relative select-none ${fallbackStyle.bg}`}>
                    {fallbackStyle.icon === 'educontrol' && (
                      <div class="flex flex-col items-center gap-1.5">
                        <svg class="w-8 h-8 text-white stroke-2 fill-none stroke-current" viewBox="0 0 24 24">
                          <polygon points="12 2 2 7 12 12 22 7 12 2" />
                          <polyline points="2 17 12 22 22 17" />
                          <polyline points="2 12 12 17 22 12" />
                        </svg>
                        <span class="font-extrabold text-sm tracking-wider uppercase text-white font-mono">EduControl</span>
                      </div>
                    )}
                    {fallbackStyle.icon === 'homescore' && (
                      <div class="flex flex-col items-center gap-1 text-center">
                        <span class="font-extrabold text-sm tracking-tight text-white">Home Score</span>
                        <span class="text-[11px] text-sky-100 font-medium">¿Puedo comprar una casa?</span>
                        <svg class="w-6 h-6 text-white stroke-2 fill-none stroke-current mt-1" viewBox="0 0 24 24">
                          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                          <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                      </div>
                    )}
                    {fallbackStyle.icon === 'uplace' && (
                      <div class="flex items-center gap-2">
                        <span class="w-3.5 h-3.5 rounded-full bg-rose-600 inline-block"></span>
                        <span class="font-extrabold text-base tracking-tight text-slate-800">UPlace</span>
                      </div>
                    )}
                  </div>
                )}

                <!-- Cuerpo de la tarjeta -->
                <div class="p-5 flex-1 flex flex-col">
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
                    <a href={p.path}>
                      <span class="absolute inset-0"></span>
                      {p.title}
                    </a>
                  </h3>

                  <p class="text-xs text-slate-500 mt-1">
                    {p.reading_minutes} {p.reading_minutes === 1 ? 'minuto' : 'minutos'}
                  </p>

                  {primaryCat && (
                    <div class="mt-3">
                      <span class="inline-block bg-blue-50 text-blue-600 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                        {primaryCat.name}
                      </span>
                    </div>
                  )}

                  {p.excerpt && (
                    <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mt-2.5 flex-1">
                      {p.excerpt}
                    </p>
                  )}

                  <!-- Pie de la tarjeta: Fecha idéntica a Figma -->
                  <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-end text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                    <time>{formatFigmaDate(p.published_at)}</time>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </section>

    <!-- Sección 2: Temas del blog (Aprender por caminos distintos) -->
    <section id="temas" class="space-y-6">
      <div class="flex items-end justify-between">
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500">Temas del blog</span>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Aprender por caminos distintos</h2>
        </div>
        <a href="#temas" class="text-xs font-bold text-blue-600 hover:text-blue-700 transition-colors flex items-center gap-1">
          Ver categorías ›
        </a>
      </div>

      {categories.length === 0 ? (
        <div class="bg-white rounded-2xl border border-slate-200/90 p-8 text-center text-slate-500 text-sm">
          Aún no hay categorías registradas en el CMS.
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {categories.map((c) => {
            const design = getCategoryDesign(c.name);

            return (
              <div class="bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-sm hover:border-blue-400/50 hover:shadow-md transition-all flex flex-col justify-between group">
                <!-- Cabecera suave con logo según Figma -->
                <div class={`h-24 ${design.headerBg} p-4 flex items-center justify-center gap-2 select-none border-b border-slate-100`}>
                  {design.icon === 'kotlin' && (
                    <div class="flex items-center gap-2">
                      <svg class="w-6 h-6" viewBox="0 0 24 24">
                        <polygon points="24,24 0,24 0,0 24,0 12,12" fill="#7F52FF" />
                      </svg>
                      <span class="font-extrabold text-base text-slate-900">Kotlin</span>
                    </div>
                  )}

                  {design.icon === 'fastapi' && (
                    <div class="flex items-center gap-2">
                      <svg class="w-6 h-6 text-emerald-600 fill-current" viewBox="0 0 24 24">
                        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-.92 18.5v-5.263H7.667L12.92 5.5v5.263h3.413L11.08 18.5z"/>
                      </svg>
                      <span class="font-extrabold text-base text-slate-900">FastAPI</span>
                    </div>
                  )}

                  {design.icon === 'python' && (
                    <div class="flex items-center gap-2">
                      <svg class="w-6 h-6" viewBox="0 0 24 24">
                        <path fill="#3776AB" d="M11.9 2c-3.1 0-5 1.4-5 3.3v2.2h5v.6H4.7c-2 0-3.7 1.6-3.7 3.6 0 2 1.4 3.7 3.4 3.7h1.6v-2.3c0-1.8 1.5-3.3 3.3-3.3h5.1c1.5 0 2.8-1.2 2.8-2.8V5.3c0-1.9-1.9-3.3-5.3-3.3zm-1.8 1.4c.5 0 1 .4 1 1s-.5 1-1 1-1-.4-1-1 .5-1 1-1z"/>
                        <path fill="#FFD43B" d="M12.1 22c3.1 0 5-1.4 5-3.3v-2.2h-5v-.6h7.2c2 0 3.7-1.6 3.7-3.6 0-2-1.4-3.7-3.4-3.7h-1.6v2.3c0 1.8-1.5 3.3-3.3 3.3H9.6c-1.5 0-2.8 1.2-2.8 2.8v1.7c0 1.9 1.9 3.3 5.3 3.3zm1.8-1.4c-.5 0-1-.4-1-1s.5-1 1-1 1 .4 1 1-.5 1-1 1z"/>
                      </svg>
                      <span class="font-extrabold text-base text-slate-900">python™</span>
                    </div>
                  )}

                  {design.icon === 'react' && (
                    <div class="flex items-center gap-2">
                      <svg class="w-6 h-6 text-sky-500 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                        <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(30 12 12)"/>
                        <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(90 12 12)"/>
                        <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(150 12 12)"/>
                        <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                      </svg>
                      <span class="font-extrabold text-base text-slate-900">React</span>
                    </div>
                  )}

                  {design.icon === 'code' && (
                    <div class="flex items-center gap-2">
                      <span class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs font-mono">
                        {c.name.substring(0, 2).toUpperCase()}
                      </span>
                      <span class="font-extrabold text-base text-slate-900 truncate max-w-[140px]">{c.name}</span>
                    </div>
                  )}
                </div>

                <!-- Contenido de la categoría -->
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <span class={`inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${design.badgeClass}`}>
                      {design.badgeText}
                    </span>
                    <h3 class="text-sm font-bold text-slate-900 mt-2 mb-1">
                      {design.title}
                    </h3>
                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
                      {design.desc}
                    </p>
                  </div>
                  
                  <a 
                    href={`/categoria/${c.slug}/`} 
                    class="text-xs font-semibold text-blue-600 hover:text-blue-700 hover:underline inline-flex items-center gap-1 transition-colors"
                  >
                    Explorar tema
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>

    <!-- Banner / Callout inferior idéntico al Figma -->
    <section class="bg-white rounded-2xl border border-slate-200/90 p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="w-11 h-11 rounded-full bg-blue-100 text-blue-600 font-bold flex items-center justify-center text-sm border border-blue-200 shrink-0 shadow-sm">
          JR
        </div>
        <div>
          <p class="text-sm font-bold text-slate-900">Un cuaderno que sigue creciendo</p>
          <p class="text-xs text-slate-500 mt-0.5">Cada nueva entrada recoge una parte real de mi recorrido académico y profesional.</p>
        </div>
      </div>
      <a 
        href="#articulos" 
        class="bg-[#2563EB] hover:bg-blue-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm shrink-0 active:scale-95"
      >
        Leer el blog
      </a>
    </section>

  </div>
</Base>

</Base>