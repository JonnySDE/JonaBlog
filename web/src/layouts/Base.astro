---
// Importante: Vincula los estilos de Tailwind para el diseño general
import '../styles/global.css';

// Plantilla común: encabezado, pie y script de métricas anónimas.
const { title, slug = null } = Astro.props;
const metricsUrl = import.meta.env.PUBLIC_METRICS_URL;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · JonaBlog</title>
    <!-- Fuentes de Google: Inter y JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFC] text-slate-800 font-['Inter',sans-serif] min-h-screen flex flex-col selection:bg-blue-600 selection:text-white antialiased">
    
    <!-- Barra de Navegación Superior idéntica al Figma -->
    <header class="bg-[#0A1128] text-white sticky top-0 z-50 border-b border-slate-800/80 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group transition-opacity hover:opacity-95">
          <!-- Chevron azul -->
          <svg class="w-3.5 h-3.5 text-sky-400 fill-current" viewBox="0 0 24 24">
            <polygon points="12,4 4,20 20,20" />
          </svg>
          <span class="text-sky-400 font-mono font-bold text-sm tracking-tight">&lt;/&gt;</span>
          <span class="font-extrabold text-white text-lg tracking-tight">JonaBlog</span>
        </a>
        
        <!-- Enlaces centrales -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a href="/" class="text-white font-semibold transition-colors">Inicio</a>
          <a href="/#articulos" class="text-slate-300 hover:text-white transition-colors">Artículos</a>
          <a href="/#temas" class="text-slate-300 hover:text-white transition-colors">Categorías</a>
          <a href="#social" class="text-slate-300 hover:text-white transition-colors">Social Media</a>
        </nav>

        <!-- Botón acción derecha -->
        <div class="flex items-center gap-3">
          <a 
            href="https://jonnysde.github.io/Landing-JonaBlog/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-[#2563EB] hover:bg-blue-600 text-white text-xs sm:text-sm font-semibold px-4 sm:px-5 py-2 sm:py-2 rounded-lg transition-all shadow-md shadow-blue-500/20 active:scale-95"
          >
            Volver al portafolio
          </a>
        </div>

      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow w-full">
      <slot />
    </main>

    <!-- Footer General idéntico al Figma -->
    <footer id="social" class="bg-[#0A1128] text-slate-300 py-10 mt-16 border-t border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6">
          <div>
            <h4 class="font-bold text-white text-base tracking-tight">Jonathan Rodríguez</h4>
            <p class="text-xs text-slate-400 mt-1">Estudiante de Ingeniería en Tecnología de la Información e Innovación Digital - UPChiapas</p>
          </div>
          
          <!-- Redes Sociales circulares como en el Figma -->
          <div class="flex items-center gap-3">
            <a 
              href="https://github.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="GitHub" 
              class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700/60 flex items-center justify-center text-slate-300 hover:text-white transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
            <a 
              href="https://linkedin.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="LinkedIn" 
              class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700/60 flex items-center justify-center text-slate-300 hover:text-white transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a 
              href="https://jonnysde.github.io/Landing-JonaBlog/" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="Portafolio" 
              class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700/60 flex items-center justify-center text-slate-300 hover:text-white transition-colors"
            >
              <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-800/80 text-xs text-slate-500">
          <span>© 2026 Jonathan Rodríguez • JonaBlog</span>
        </div>
      </div>
    </footer>

    <!-- Script de métricas: anónimo, sin cookies, sin datos personales -->
    <script is:inline define:vars={{ metricsUrl, slug }}>
      (function () {
        if (!metricsUrl) return;
        var sid;
        try {
          sid = sessionStorage.getItem('sid');
          if (!sid) { sid = crypto.randomUUID(); sessionStorage.setItem('sid', sid); }
        } catch (e) { sid = crypto.randomUUID(); }

        function send(input) {
          var query = 'mutation($i: EventInput!){ recordEvent(input: $i){ status } }';
          fetch(metricsUrl, {
            method: 'POST',
            keepalive: true,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: query, variables: { i: input } }),
          }).catch(function () {});
        }
        function base(type) {
          return {
            eventId: crypto.randomUUID(), type: type, sessionId: sid,
            path: location.pathname, slug: slug, referrer: document.referrer || null,
          };
        }

        send(base('pageview'));

        if (slug) {
          var start = Date.now(), maxScroll = 0, sent = false;
          addEventListener('scroll', function () {
            var h = document.documentElement.scrollHeight - innerHeight;
            if (h > 0) maxScroll = Math.max(maxScroll, Math.round((scrollY / h) * 100));
          }, { passive: true });
          function sendRead() {
            if (sent) return; sent = true;
            send(Object.assign(base('read'), {
              readingSeconds: Math.round((Date.now() - start) / 1000),
              scrollPercent: maxScroll,
            }));
          }
          addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') sendRead();
          });
          addEventListener('pagehide', sendRead);
        }
      })();
    </script>
  </body>
</html>

</html>