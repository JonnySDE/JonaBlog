# Copia como ".env" para correr "npm run dev" en tu computadora.
# En Vercel se capturan en Settings > Environment Variables del proyecto WEB.

# URL base de la API del CMS (sin diagonal final)
CMS_API_URL=http://localhost:8000/cms/v1
# Mismo valor que CMS_API_TOKEN de la API (token de SOLO LECTURA)
CMS_API_TOKEN=cambia-esto-1

# Endpoint GraphQL de métricas que usará el navegador del lector
PUBLIC_METRICS_URL=http://localhost:8000/metrics/v1/graphql
